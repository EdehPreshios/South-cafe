                      <span className="text-white font-mono">+${85 * bookingForm.travelers}</span>
                    </div>
                  )}
                  {bookingForm.addons.guide && (
                    <div className="flex justify-between text-slate-400">
                      <span>Private Tour Guide:</span>
                      <span className="text-white font-mono">+$250</span>
                    </div>
                  )}
                  <div className="pt-2 border-t border-slate-800 flex justify-between font-bold text-sm text-amber-400">
                    <span>Total Due:</span>
                    <span>${calculateTotal().toLocaleString()}</span>
                  </div>
                </div>

                <button 
                  type="submit"
                  className="w-full py-3.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm rounded-xl transition-all shadow-lg shadow-amber-500/20"
                >
                  Confirm & Pay (Simulated)
                </button>
              </form>
            )}

            {/* Step 3: Confirmation Receipt */}
            {bookingStep === 3 && (
              <div className="p-8 text-center space-y-6">
                <div className="h-16 w-16 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto border border-emerald-500/30">
                  <CheckCircle className="h-8 w-8" />
                </div>

                <div className="space-y-2">
                  <h3 className="text-2xl font-black text-white">Trip Confirmed!</h3>
                  <p className="text-slate-400 text-sm">Your voucher receipt and itinerary details have been dispatched to your account.</p>
                </div>

                <div className="bg-slate-950 p-6 rounded-2xl border border-slate-800 text-left max-w-md mx-auto space-y-3 text-xs">
                  <div className="flex justify-between border-b border-slate-800 pb-2">
                    <span className="text-slate-400">Booking Reference:</span>
                    <span className="font-mono font-bold text-amber-400">{bookedTrips[0]?.id}</span>
                  </div>
                  <div className="flex justify-between border-b border-slate-800 pb-2">
                    <span className="text-slate-400">Destination:</span>
                    <span className="font-bold text-white">{selectedDest.title}</span>
                  </div>
                  <div className="flex justify-between border-b border-slate-800 pb-2">
                    <span className="text-slate-400">Travelers:</span>
                    <span className="text-white">{bookingForm.travelers} Guests</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-400">Total Paid:</span>
                    <span className="font-bold text-emerald-400 font-mono">${calculateTotal().toLocaleString()}</span>
                  </div>
                </div>

                <div className="flex items-center justify-center gap-4">
                  <button 
                    onClick={() => { setSelectedDest(null); setActiveTab('bookings'); }}
                    className="px-6 py-2.5 bg-amber-500 text-slate-950 font-bold text-xs rounded-xl"
                  >
                    View My Bookings Dashboard
                  </button>
                </div>
              </div>
            )}

          </div>
        </div>
      )}

      {/* Footer */}
      <footer className="mt-20 border-t border-slate-800 bg-slate-950 py-12 text-slate-500 text-xs text-center space-y-3">
        <div className="flex items-center justify-center gap-2">
          <Compass className="h-4 w-4 text-amber-400" />
          <span className="font-bold text-white tracking-wider">WANDERLUXE TRAVEL CO.</span>
        </div>
        <p>© 2026 WanderLuxe Travel Agency Platform. All rights reserved. Premium Handcrafted Escapes.</p>
      </footer>

    </div>
  );
}